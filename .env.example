# SnackBase Environment Configuration
# Copy this file to .env and update with your values

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
SNACKBASE_APP_NAME=SnackBase
SNACKBASE_APP_VERSION=0.12.0
SNACKBASE_ENVIRONMENT=development
SNACKBASE_DEBUG=false
SNACKBASE_API_PREFIX=/api/v1
SNACKBASE_EXTERNAL_URL=http://localhost:8000
SNACKBASE_IS_DEMO=false
SNACKBASE_AUDIT_LOGGING_ENABLED=true

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
SNACKBASE_HOST=0.0.0.0
SNACKBASE_PORT=8000
SNACKBASE_WORKERS=1

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
SNACKBASE_DATABASE_URL=sqlite+aiosqlite:///./sb_data/snackbase.db
SNACKBASE_DB_POOL_SIZE=5
SNACKBASE_DB_MAX_OVERFLOW=10
SNACKBASE_DB_POOL_TIMEOUT=30
SNACKBASE_DB_POOL_RECYCLE=3600
SNACKBASE_DB_ECHO=false

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
# Use a secure random hex string (openssl rand -hex 32).
# All three MUST be set to real values in production — the app refuses to boot
# on these placeholders when SNACKBASE_ENVIRONMENT=production.
SNACKBASE_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
SNACKBASE_TOKEN_SECRET=change-me-in-production-use-openssl-rand-hex-32
SNACKBASE_ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32
SNACKBASE_ACCESS_TOKEN_EXPIRE_MINUTES=60
SNACKBASE_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# CORS Settings
# Accepts a comma-separated list of origins (12-factor convention).
# Example: SNACKBASE_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# ------------------------------------------------------------------------------
SNACKBASE_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173
SNACKBASE_CORS_ALLOW_CREDENTIALS=true
SNACKBASE_CORS_ALLOW_METHODS=*
SNACKBASE_CORS_ALLOW_HEADERS=*

# ------------------------------------------------------------------------------
# Logging Settings
# ------------------------------------------------------------------------------
SNACKBASE_LOG_LEVEL=INFO
SNACKBASE_LOG_FORMAT=json
# SNACKBASE_LOG_FILE=./server.log

# ------------------------------------------------------------------------------
# File Storage Settings
# ------------------------------------------------------------------------------
SNACKBASE_STORAGE_PATH=./sb_data/files
SNACKBASE_MAX_FILE_SIZE=10485760  # 10MB in bytes
SNACKBASE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/json

# ------------------------------------------------------------------------------
# Rate Limiting Settings
# ------------------------------------------------------------------------------
# Raise the limits rather than turning this off — it is the only bound on
# request-rate abuse, and login guessing is bounded separately below.
# Only paths under /api/v1 are metered. The SPA, its assets, and the health,
# readiness and liveness probes are never rate limited.
SNACKBASE_RATE_LIMIT_ENABLED=true
SNACKBASE_RATE_LIMIT_PER_MINUTE=60
# Burst ceiling as a multiple of the per-minute allowance. 1.0 lets a client
# spend a full minute's budget at once; the bucket then refills at that rate.
SNACKBASE_RATE_LIMIT_BURST_MULTIPLIER=1.0
SNACKBASE_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
SNACKBASE_RATE_LIMIT_ENDPOINTS={}
# Peers whose X-Forwarded-For or CF-Connecting-IP may be believed. Each entry is
# a bare address (127.0.0.1), a CIDR network (10.0.0.0/8), or the literal '*'.
# Leaving it wrong makes every proxied client share one rate-limit bucket and one
# login-failure budget. On a managed platform (Railway, Fly, Render) the edge
# address is neither stable nor published, so '*' is the correct value there —
# but only because the app is not directly reachable from the internet. Never
# use '*' on an instance clients can connect to without passing your proxy.
SNACKBASE_TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# Login Brute-Force Protection
# ------------------------------------------------------------------------------
# Failed logins per client IP per minute. Must stay below the lockout threshold
# so hammering one victim exhausts the attacker's IP budget, not the victim's account.
SNACKBASE_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Consecutive failures before the account itself locks; each further lockout doubles.
SNACKBASE_LOGIN_LOCKOUT_THRESHOLD=20
SNACKBASE_LOGIN_LOCKOUT_SECONDS=900

# ------------------------------------------------------------------------------
# SAML Settings
# ------------------------------------------------------------------------------
# Tolerance on assertion NotBefore/NotOnOrAfter. Widening it lengthens the window
# in which a captured assertion is still replayable.
SNACKBASE_SAML_CLOCK_SKEW_SECONDS=60

# ------------------------------------------------------------------------------
# API Key Settings
# ------------------------------------------------------------------------------
SNACKBASE_API_KEY_HEADER=X-API-Key
SNACKBASE_API_KEY_MAX_PER_USER=10
# SNACKBASE_API_KEY_DEFAULT_EXPIRATION_DAYS=90
SNACKBASE_API_KEY_RATE_LIMIT_PER_MINUTE=100

# ------------------------------------------------------------------------------
# Security Headers Middleware
# ------------------------------------------------------------------------------
SNACKBASE_SECURITY_HEADERS_ENABLED=true
SNACKBASE_HSTS_MAX_AGE=31536000
SNACKBASE_CSP_POLICY="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'"
SNACKBASE_PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
SNACKBASE_HTTPS_REDIRECT_ENABLED=false

# ------------------------------------------------------------------------------
# Superadmin Auto-Creation (optional)
# ------------------------------------------------------------------------------
# SNACKBASE_SUPERADMIN_EMAIL=admin@example.com
# SNACKBASE_SUPERADMIN_PASSWORD=ChangeMe123!

# ------------------------------------------------------------------------------
# Cache Settings
# ------------------------------------------------------------------------------
SNACKBASE_PERMISSION_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Single-Tenant Mode (optional)
# ------------------------------------------------------------------------------
# When enabled, all user registrations join a pre-configured account
# with "user" role. The account is created automatically on startup.
SNACKBASE_SINGLE_TENANT_MODE=false
# Account slug (REQUIRED when mode=true)
# SNACKBASE_SINGLE_TENANT_ACCOUNT=my-app
# Optional display name (defaults to slug)
# SNACKBASE_SINGLE_TENANT_ACCOUNT_NAME=My Application

# ------------------------------------------------------------------------------
# Platform Trusted-Issuer Authentication (optional, default-off)
# ------------------------------------------------------------------------------
# Federated admin access via an external JWT issuer (e.g. SnackBase Cloud or your
# own OIDC provider). Leave all unset for behaviour identical to stock SnackBase.
# Requires single-tenant mode when enabled.
# SNACKBASE_PLATFORM_ISSUER=https://platform.example.com
# SNACKBASE_PLATFORM_JWKS_URL=https://platform.example.com/.well-known/jwks.json
# SNACKBASE_PLATFORM_AUDIENCE=snackbase-instance
# SNACKBASE_PLATFORM_ROLE_CLAIM=snackbase_role
# SNACKBASE_PLATFORM_EMAIL_CLAIM=email
# SNACKBASE_PLATFORM_JWKS_CACHE_SECONDS=300
# SNACKBASE_PLATFORM_MAX_TOKEN_AGE_SECONDS=300
# SNACKBASE_PLATFORM_SOCKET_MAX_LIFETIME_SECONDS=3600

# ------------------------------------------------------------------------------
# Functions
# ------------------------------------------------------------------------------
# Dependency pin mode. "allowlist" (default) only installs packages named in
# SNACKBASE_FUNCTION_DEPENDENCY_ALLOWLIST. "open_pinned" lets any account admin
# install any pinned PyPI package into a function env on this host.
SNACKBASE_FUNCTION_DEPENDENCY_MODE=allowlist
# SNACKBASE_FUNCTION_DEPENDENCY_ALLOWLIST=httpx,pydantic
# OS-level confinement for invokes: auto (default; treated as "required" in
# production), required, or disabled. Confinement uses the kernel's Landlock
# LSM and needs Linux 5.13+.
SNACKBASE_FUNCTION_SANDBOX_MODE=auto
SNACKBASE_FUNCTION_MEMORY_LIMIT_MB=512
