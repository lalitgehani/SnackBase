# syntax=docker/dockerfile:1
#
# SnackBase Cloud platform Studio image (nginx + runtime config injection).
# Build with VITE_IS_PLATFORM=true; proxies /platform/v1/* to the platform gateway.

FROM node:20-bookworm-slim AS build
WORKDIR /app

COPY package.json ./

RUN node <<'EOF'
const fs = require('fs')
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'))
pkg.dependencies['@snackbase/sdk'] = '0.8.0'
pkg.dependencies['@snackbase/react'] = '0.5.0'
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n')
EOF

RUN npm install --legacy-peer-deps

COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json components.json ./
COPY public ./public
COPY src ./src

ENV VITE_IS_PLATFORM=true
ENV VITE_SNACKBASE_URL=http://localhost:8002
ENV VITE_PROVISION_API_URL=http://localhost:8091
ENV VITE_PLATFORM_PATH_PREFIX=/platform/v1

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.platform.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker/entrypoint.platform.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY --from=build /app/dist /usr/share/nginx/html

ENV SNACKBASE_URL=http://localhost:8002
ENV PROVISION_API_URL=http://localhost:8091
ENV PLATFORM_GATEWAY_URL=http://platform-gateway:8080
ENV PLATFORM_PATH_PREFIX=/platform/v1
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
