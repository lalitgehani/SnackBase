# syntax=docker/dockerfile:1
#
# SnackBase Cloud platform Studio image (nginx + runtime config injection).
# Build context: SnackBase repo root. SDK packages come from the registry pins
# in ui/package-lock.json (@snackbase/sdk, @snackbase/react).
# Proxies /platform/v1/* to the platform gateway.

FROM node:20-bookworm-slim AS build
WORKDIR /app/ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/ .

ENV VITE_IS_PLATFORM=true
ENV VITE_SNACKBASE_URL=http://localhost:8002
ENV VITE_PROVISION_API_URL=http://localhost:8091
ENV VITE_PLATFORM_PATH_PREFIX=/platform/v1

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY ui/docker/nginx.platform.conf.template /etc/nginx/conf.d/default.conf.template
COPY ui/docker/entrypoint.platform.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY --from=build /app/ui/dist /usr/share/nginx/html

ENV SNACKBASE_URL=http://localhost:8002
ENV PROVISION_API_URL=http://localhost:8091
ENV PLATFORM_GATEWAY_URL=http://platform-gateway:8080
ENV PLATFORM_PATH_PREFIX=/platform/v1
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
